rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada padre/tutor solo puede leer y escribir sus propios perfiles de hijos
    // y el progreso guardado dentro de cada uno.
    match /usuarios/{uid}/perfiles/{perfilId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    match /usuarios/{uid}/perfiles/{perfilId}/progreso/{moduloId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
