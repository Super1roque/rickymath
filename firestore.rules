rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Super usuario de la PLATAFORMA (no un padre/tutor más) — administra
    // los tenants (cuentas de padres). No depende de tener doc propio en
    // usuarios/{uid}: se agrega directo en Firestore, nunca desde la app.
    function isSuperAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/superadmins/$(request.auth.uid));
    }

    match /superadmins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if false;
    }

    // El doc del padre/tutor (nombre, email, teléfono, status). El dueño
    // puede crearlo/leerlo/editarlo; el superadmin puede leer y editar
    // cualquiera (para el panel de gestión) pero no crear ni borrar —
    // igual que tenants en pos-saas, nunca se borra duro.
    match /usuarios/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow delete: if false;
    }

    // Cada padre/tutor solo puede leer y escribir sus propios perfiles de hijos
    // y el progreso guardado dentro de cada uno. El superadmin puede leer
    // (no escribir) para poder mostrar cantidad de hijos en el panel.
    match /usuarios/{uid}/perfiles/{perfilId} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if signedIn() && request.auth.uid == uid;
    }
    match /usuarios/{uid}/perfiles/{perfilId}/progreso/{moduloId} {
      allow read: if signedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow write: if signedIn() && request.auth.uid == uid;
    }
  }
}
